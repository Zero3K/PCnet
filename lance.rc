#include <windows.h>
#include <ntverp.h>

/*-----------------------------------------------*/
/* the following lines are specific to this file */
/*-----------------------------------------------*/

/* VER_FILETYPE, VER_FILESUBTYPE, VER_FILEDESCRIPTION_STR
 * and VER_INTERNALNAME_STR must be defined before including COMMON.VER
 * The strings don't need a '\0', since common.ver has them.
 */
#define	VER_FILETYPE	VFT_DRV
/* possible values:		VFT_UNKNOWN
				VFT_APP
				VFT_DLL
				VFT_DRV
				VFT_FONT
				VFT_VXD
				VFT_STATIC_LIB
*/
#define	VER_FILESUBTYPE	VFT2_DRV_NETWORK
/* possible values		VFT2_UNKNOWN
				VFT2_DRV_PRINTER
				VFT2_DRV_KEYBOARD
				VFT2_DRV_LANGUAGE
				VFT2_DRV_DISPLAY
				VFT2_DRV_MOUSE
				VFT2_DRV_NETWORK
				VFT2_DRV_SYSTEM
				VFT2_DRV_INSTALLABLE
				VFT2_DRV_SOUND
				VFT2_DRV_COMM
*/
#define VER_FILEDESCRIPTION_STR     "AMD PCnet family NDIS 5.1 miniport (pcntn5m)"
#define VER_INTERNALNAME_STR        "pcntn5m.sys"
#define VER_ORIGINALFILENAME_STR    "pcntn5m.sys"

/* Keep in step with DriverVer in pcntn5m.inf. */
#define VER_FILEVERSION             1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0"

/* ntverp.h describes the WDK itself here ("Windows (R) Win 7 DDK
 * driver", 6.1.7600.16385). Describe this driver instead. */
#undef  VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR         "PCnet NDIS 5.1 miniport (pcntn5m)"
#undef  VER_PRODUCTVERSION
#define VER_PRODUCTVERSION          1,0,0,0
#undef  VER_PRODUCTVERSION_STR
#define VER_PRODUCTVERSION_STR      "1.0.0.0"

#include "common.ver"
