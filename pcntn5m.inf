
; pcntn5m.inf
; AMD PCnet PCI Ethernet adapter
; Supports Windows 2000, XP, Server 2003, Windows 7 x86 and x64.

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %AMD%
DriverVer   = 02/14/2024,5.0.0.0
CatalogFile.NTamd64 = pcntn5m.cat

[Manufacturer]
%AMD% = AMD,NT,NTx86,NTamd64

; Windows 2000
[AMD.NT]
%PCNTN5M_PCI0.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2000
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2001
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2621
%PCNTN5M_FAST1.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2623
%PCNTN5M_FAST2.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2624
%PCNTN5M_FAST3.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2625
%PCNTN5M_FAST3B.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2627
%PCNTN5M_PCI3.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2626

; Windows XP, Server 2003, Vista and Windows 7 x86
[AMD.NTx86]
%PCNTN5M_PCI0.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2000
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2001
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2621
%PCNTN5M_FAST1.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2623
%PCNTN5M_FAST2.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2624
%PCNTN5M_FAST3.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2625
%PCNTN5M_FAST3B.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2627
%PCNTN5M_PCI3.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2626

; Windows 7 x64 / AMD64
[AMD.NTamd64]
%PCNTN5M_PCI0.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2000
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2001
%PCNTN5M_PCI1.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2621
%PCNTN5M_FAST1.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2623
%PCNTN5M_FAST2.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2624
%PCNTN5M_FAST3.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2625
%PCNTN5M_FAST3B.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2627
%PCNTN5M_PCI3.DeviceDesc%  = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2626

; PCI adapter installation
[PCNTN5M_PCI.ndi]
Characteristics = 0x4
BusType         = 5    ; PCI
AddReg          = PCNTN5M_PCI.ndi.reg
CopyFiles       = PCNTN5M.CopyFiles

[PCNTN5M_PCI.ndi.Services]
AddService = PCNTN5M, 2, PCNTN5M.Service, PCNTN5M.EventLog

[PCNTN5M_PCI.ndi.reg]
HKR, Ndi,              Service,    0, "PCNTN5M"
HKR, Ndi\Interfaces,   UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,   LowerRange, 0, "ethernet"

HKR, Ndi, *IfType,            0x00010003, 6
HKR, Ndi, *MediaType,         0x00010003, 0
HKR, Ndi, *PhysicalMediaType, 0x00010003, 0

HKR, , BusType, 0x00010001, 5

; Kernel driver service
[PCNTN5M.Service]
DisplayName    = %PCNTN5M.Service.DispName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\pcntn5m.sys
LoadOrderGroup = NDIS

; Event logging
[PCNTN5M.EventLog]
AddReg = PCNTN5M.EventLog.reg

[PCNTN5M.EventLog.reg]
HKR,, EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR,, TypesSupported,   0x00010001, 7

; Driver file
[PCNTN5M.CopyFiles]
pcntn5m.sys

[DestinationDirs]
PCNTN5M.CopyFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
pcntn5m.sys = 1

[Strings]
AMD                      = "AMD"
PCNTN5M.Service.DispName = "AMD PCnet PCI Miniport"
DiskName                 = "AMD PCnet PCI Driver Disk"

PCNTN5M_PCI0.DeviceDesc  = "AMD PCnet-PCI Ethernet Adapter (Am79C970)"
PCNTN5M_PCI1.DeviceDesc  = "AMD PCnet-PCI II Ethernet Adapter"
PCNTN5M_PCI3.DeviceDesc  = "AMD PCnet-FAST III Ethernet Adapter (Am79C973)"
PCNTN5M_FAST1.DeviceDesc = "AMD PCnet-FAST Ethernet Adapter (Am79C971)"
PCNTN5M_FAST2.DeviceDesc = "AMD PCnet-FAST+ Ethernet Adapter (Am79C972)"
PCNTN5M_FAST3.DeviceDesc  = "AMD PCnet-FAST III Ethernet Adapter (Am79C973)"
PCNTN5M_FAST3B.DeviceDesc = "AMD PCnet-FAST III Ethernet Adapter (Am79C975)"
