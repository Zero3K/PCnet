; pcntn5m.inf
;
; AMD PCnet-PCI / PCnet-FAST family (Am79C970, 970A, 971, 972, 973, 975),
; NDIS 5.1 miniport. The chip runs in 16-bit LANCE mode (SWSTYLE 0) with
; 24-bit DMA.
;
; Targets: Windows Server 2003 x86, Windows XP x86, Windows 7 x86 and
; ReactOS x86 (all load NDIS 5.1 miniports).
; x86 only: the driver is not 64-bit clean, so there is no NTamd64 section.
; Not for Windows 8, 10 or 11: those no longer load NDIS 5.x miniports.

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 11/18/2026,1.0.0.0

[Manufacturer]
%AMD% = AMD, NTx86

[AMD.NTx86]
%PCNTN5M_PCNET.DeviceDesc% = PCNTN5M_PCI.ndi, PCI\VEN_1022&DEV_2000

[PCNTN5M_PCI.ndi]
Characteristics = 0x4   ; NCF_PHYSICAL
BusType         = 5     ; PCIBus
AddReg          = PCNTN5M_PCI.ndi.reg
CopyFiles       = PCNTN5M.CopyFiles

[PCNTN5M_PCI.ndi.Services]
AddService = PCNTN5M, 2, PCNTN5M.Service, PCNTN5M.EventLog

[PCNTN5M_PCI.ndi.reg]
HKR, Ndi,            Service,    0, "PCNTN5M"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[PCNTN5M.Service]
DisplayName    = %PCNTN5M.Service.DispName%
ServiceType    = 1      ; SERVICE_KERNEL_DRIVER
StartType      = 3      ; SERVICE_DEMAND_START
ErrorControl   = 1      ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\pcntn5m.sys
LoadOrderGroup = NDIS

[PCNTN5M.EventLog]
AddReg = PCNTN5M.EventLog.reg

[PCNTN5M.EventLog.reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[PCNTN5M.CopyFiles]
pcntn5m.sys

[DestinationDirs]
PCNTN5M.CopyFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
pcntn5m.sys = 1

[Strings]
Provider                  = "AMD"
AMD                       = "AMD"
DiskName                  = "pcntn5m driver disk"
PCNTN5M.Service.DispName  = "AMD PCnet NDIS 5.1 miniport (pcntn5m)"
PCNTN5M_PCNET.DeviceDesc  = "AMD PCnet-PCI/FAST Ethernet Adapter (Am79C970, Am79C970A, Am79C971, Am79C972, Am79C973, Am79C975)"
